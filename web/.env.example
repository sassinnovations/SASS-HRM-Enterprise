# Recommended for local Windows development: leave this empty to use Vite's /api proxy.
# Vite forwards requests to http://127.0.0.1:8000 (see vite.config.ts).
# Set an absolute URL only when the API is hosted separately.
VITE_API_URL=

# Vercel: set VITE_API_URL to your Railway HTTPS backend origin; redeploy after changing it.
# Vercel environment variables are embedded during the frontend build, not read at runtime.
