# Provision using SETUP_SASS_HRM.bat. Do not commit .env.
MYSQL_DATABASE=sass_hrm
MYSQL_USER=sass_hrm_app
MYSQL_PASSWORD=GENERATED_BY_SETUP
MYSQL_ROOT_PASSWORD=GENERATED_BY_SETUP

# SASS AI Assistant v4: optional general GenAI + approved company RAG.
# Configure these on the BACKEND ONLY. Never place AI_API_KEY in VITE_* variables.
# Without a valid provider key the assistant gives local policy/feature help, not arbitrary answers.
AI_COPILOT_GENERATION=0
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
