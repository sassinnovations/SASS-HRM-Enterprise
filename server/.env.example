# Generated by SETUP_SASS_HRM.bat. Never commit real credentials.
APP_ENV=development
DB_ENGINE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=sass_hrm
MYSQL_USER=sass_hrm_app
MYSQL_PASSWORD=GENERATED_BY_SETUP
JWT_SECRET=GENERATED_BY_SETUP
CORS_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
# Configure an organizational SMTP provider before inviting employees.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional enterprise-reviewed AI integration:
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=

# Secure vault: generated by SETUP_SASS_HRM.bat for new local installations.
# For existing installations, configure both settings manually; the vault fails closed if either is missing.
# Generate VAULT_FERNET_KEY using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_FERNET_KEY=
VAULT_AV_HOST=
VAULT_AV_PORT=3310

# v5.2 Attendance: default to manual attendance; photo/device modes are explicitly opt-in.
ATTENDANCE_TIMEZONE=Asia/Kolkata
ATTENDANCE_PHOTO_ENABLED=0
# Generate a secret on the HRM server with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ATTENDANCE_PHOTO_FERNET_KEY=
ATTENDANCE_DEVICE_ENABLED=0
# Device gateways must sign their exact JSON bytes with HMAC-SHA256; use a unique random 32+ char secret per device.
ATTENDANCE_DEVICE_SECRETS_JSON={}

# Payroll simulations only: leave publication disabled until local finance/legal sign-off.
PAYROLL_PUBLICATION_ENABLED=0
# Recommended for production: two distinct HR admins to review and publish a run.
PAYROLL_DUAL_APPROVAL_ENABLED=1

# Railway deployment: use the platform-provided MYSQLHOST, MYSQLPORT, MYSQLUSER,
# MYSQLPASSWORD and MYSQLDATABASE variables instead of local MYSQL_* values.
# Do not set MYSQL_HOST=127.0.0.1 in Railway; it would override MYSQLHOST.
# Set CORS_ORIGINS to your exact HTTPS Vercel origin, and PUBLIC_APP_URL to the same origin.
